# Application
APP_NAME=R7 - Reconnaissance Platform
ENVIRONMENT=development
DEBUG=True

# Database (PostgreSQL for Docker/Production, SQLite for local zero-dependency testing)
DATABASE_URL=sqlite:///./recon7.db
# DATABASE_URL=postgresql://postgres:reconpassword123@localhost:5432/recon7

# Scope Authorization Gate (Set to False in production for strict attestation enforcement)
ALLOW_ALL_SCOPES_DEV=True

# AI Gateway (LiteLLM)
AI_ENABLED=True
LITELLM_MODEL=anthropic/claude-3-5-sonnet-20241022
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here

# Binary Overrides (Optional - defaults to system PATH)
# MASSCAN_BIN=/usr/bin/masscan
# NMAP_BIN=/usr/bin/nmap
# SUBFINDER_BIN=/usr/local/bin/subfinder
# HTTPX_BIN=/usr/local/bin/httpx
# NUCLEI_BIN=/usr/local/bin/nuclei
# THEHARVESTER_BIN=/usr/bin/theHarvester
# EXIFTOOL_BIN=/usr/bin/exiftool
