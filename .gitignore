# ==============================================================================
# RECON7 (.gitignore)
# Defense-grade exclusion rules for Python, Node, React/Vite, Docker & Database
# ==============================================================================

# Secrets & Environment Files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.crt
*.pfx
*.p12

# Local Databases & Persistent Storage
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
recon7.db
postgres_data/

# Python Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.nox/
.hypothesis/

# Node.js & Frontend Build Outputs
node_modules/
frontend/node_modules/
dist/
frontend/dist/
build/
.next/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Logs & Temporary Files
*.log
logs/
*.tmp
*.bak
scratch/

# IDE & Operating System Artifacts
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.gemini/
docs-site/